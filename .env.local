# ==================================================
# Local development profile
# Docker runs the infrastructure and app containers.
# Ollama runs on your host machine and is reached through host.docker.internal.
# ==================================================

APP_NAME=Rosti Local
APP_VERSION=0.1.1-local
ENVIRONMENT=development
TIMEZONE=Europe/Berlin

# --- Backend / Public URL ---
FRONTEND_BASE_URL=http://localhost:8080
SECRET_KEY=local-dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Default admin user ---
CREATE_DEFAULT_ADMIN=True
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@rag-system.de
DEFAULT_ADMIN_PASSWORD=admin12345

# --- MySQL ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=rag_db
MYSQL_USER=app
MYSQL_PASSWORD=app_password123

# --- MongoDB ---
MONGO_URI=mongodb://root:password@mongodb:27017
MONGO_DB_NAME=rag_db
MONGO_AI_CHAT_HISTORY_COLLECTION=chat_history

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=2

# --- Milvus ---
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=ai_collection
VECTOR_DIM=1024

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=mm-rag-bucket
MINIO_CHAT_BUCKET_NAME=chat-attachments
MINIO_AVATAR_BUCKET_NAME=avatars
CUSTOMER_MINIO_ENDPOINT=
CUSTOMER_MINIO_ACCESS_KEY=
CUSTOMER_MINIO_SECRET_KEY=
CUSTOMER_MINIO_BUCKET_NAME=
MINIO_SYNC_ENABLED=False

# --- Ollama on local host ---
# Windows/macOS Docker Desktop: host.docker.internal works out of the box.
# Linux: this compose file adds host-gateway for the backend container.
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434
OLLAMA_SERVING_URL=http://host.docker.internal:11434/api
OLLAMA_EMBEDDING_URL=http://host.docker.internal:11434/api
OLLAMA_EMBEDDING_API_URL=http://host.docker.internal:11434/api/embeddings

# Recommended local models. Pull them once with:
# ollama pull qwen3:0.6b
# ollama pull mxbai-embed-large:latest
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_QWEN_MODEL=qwen2.5:0.5b
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_COT_MODEL=qwen2.5:0.5b
OLLAMA_LLAVA_MODEL=llava:latest
OLLAMA_QWEN_VL_MAX_LATEST=qwen2.5vl:7b
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
OLLAMA_EMBEDDING_MODEL_NAME=mxbai-embed-large:latest
OLLAMA_RERANKER_MODEL=
OLLAMA_RERANK_MODEL=
OLLAMA_RERANK_API_URL=
OLLAMA_RERANKER_MODEL_NAME=
OLLAMA_NUM_PREDICT=2048
OLLAMA_DEVICE=cuda

# Use Ollama for embeddings so the backend does not need to load HF models locally.
EMBEDDING_STRATEGY=ollama
# Leave reranking disabled locally unless you configure a compatible rerank endpoint.
RERANK_STRATEGY=none
LOCAL_EMBEDDING_MODEL=
LOCAL_RERANKER_MODEL=

# --- PDF / OCR processing ---
PDF_PROCESSING_STRATEGY=pipeline
PDF_PARSE_STRATEGY=pymupdf
MINERU_PARSE_BACKEND=pipeline
MINERU_SGLANG_SERVER_URL=
MINERU_FORCE_MODE=pipeline
PADDLEOCR_API_URL=http://paddleocr:8080
LATEXOCR_API_URL=http://latexocr:8002/predict

# --- Optional external services disabled locally ---
QW_API_KEY=
BING_SEARCH_KEY=
BING_SEARCH_ENDPOINT=
MSAD_SSO_ENABLED=False
GOOGLE_AUTH_ENABLE=False
MICROSOFT_AUTH_ENABLE=False
OAUTH_GENERIC_AUTH_ENABLE=False
SMTP_SERVER=localhost
SMTP_PORT=1
SMTP_USER=dummy
SMTP_PASSWORD=dummy
SMTP_SENDER_EMAIL=dummy@example.local

# --- Agent settings ---
AGENTIC_RAG_ENABLE=False
MAX_VALIDATION_RETRIES=5
MAX_CONTEXT_TOKENS=6000
AI_TEMPLATE_SEGMENT_SPLIT_MAX_SIZE=2000
SCAN_DETECTION_THRESHOLD_DEFAULT=20
