# Optimiertes Dockerfile - reduziert die Neubauzeit bei Abhängigkeitsänderungen
FROM python:3.12-slim AS base-dependencies

# 1. Systemabhängigkeitsebene - ändert sich selten
RUN sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libgl1 \
        libglib2.0-0 \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Stabile Kernabhängigkeitsebene - trennt Basis- und variable Abhängigkeiten
FROM base-dependencies AS core-dependencies

# Getrennte Kernabhängigkeitsdateien kopieren
COPY requirements.core.txt ./
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.core.txt

# 3. Variable Abhängigkeitsebene - ändert sich häufig
FROM core-dependencies AS variable-dependencies

# Häufig geänderte Abhängigkeitsdateien kopieren
COPY requirements.extras.txt ./
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.extras.txt

# 4. Anwendungs-Build-Ebene
FROM python:3.12-slim AS builder

WORKDIR /usr/src/app

# Build-Werkzeuge installieren
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple wheel setuptools

# Für den Build benötigte Dateien kopieren
COPY setup.py requirements.txt ./
COPY app ./app

# Wheel-Paket der Anwendung bauen
RUN python setup.py bdist_wheel

# 5. Finales Produktionsimage
FROM variable-dependencies AS final

# Nicht-Root-Benutzer erstellen
RUN addgroup --system app && adduser --system --ingroup app --home /app app

# Logverzeichnis erstellen
RUN mkdir -p /app/logs/api_log && chown -R app:app /app/logs

# Anwendung kopieren und installieren
COPY --from=builder /usr/src/app/dist/*.whl ./
RUN pip install --no-cache-dir --no-deps rosti_backend-0.1.0-py3-none-any.whl && \
    rm rosti_backend-0.1.0-py3-none-any.whl

# Alembic-Konfiguration kopieren
COPY alembic.ini .
COPY alembic ./alembic

# Berechtigungen setzen
RUN chown -R app:app /app
ENV HOME=/app
USER app

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]