# Local backend image.
# Uses the standard Debian/PyPI mirrors instead of the original China mirrors and
# keeps Ollama outside Docker. Ollama is reached through host.docker.internal.

FROM python:3.12-slim AS builder

WORKDIR /usr/src/app

RUN pip install --no-cache-dir wheel setuptools

COPY setup.py requirements.txt ./
COPY app ./app

RUN python setup.py bdist_wheel

FROM python:3.12-slim

RUN addgroup --system app && adduser --system --ingroup app --home /app app

WORKDIR /app

RUN mkdir -p /app/logs/api_log && chown -R app:app /app/logs

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libgl1 \
        libglib2.0-0 \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/src/app/requirements.txt .
RUN pip install -r requirements.txt

# MinerU is still installed because the application imports it in the PDF stack.
# The local .env forces pipeline mode and does not start the heavy sglang server.
RUN pip install --no-cache-dir 'mineru[core]'

COPY --from=builder /usr/src/app/dist/*.whl .
RUN pip install --no-cache-dir --no-deps rosti_backend-0.1.0-py3-none-any.whl && \
    rm rosti_backend-0.1.0-py3-none-any.whl

COPY alembic.ini .
COPY alembic ./alembic

RUN chown -R app:app /app
ENV HOME=/app
USER app

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
